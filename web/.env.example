# Local development environment variables — copy this file to `.env.local`
# (already gitignored via the `*.local` rule) and fill in real values.
# Vite loads `.env.local` automatically; nothing here needs VITE_API_BASE
# since the dev server proxies /api to the backend (see vite.config.ts).

# Supabase -> Project Settings -> API -> Project URL / anon public key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
