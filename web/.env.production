# Production build configuration for the PokéTracker frontend.
#
# Vite automatically loads this file during `vite build` (production mode)
# and inlines any VITE_-prefixed variable into the bundle at BUILD time.
#
# Why this exists:
#   src/api/client.ts reads `import.meta.env.VITE_API_BASE ?? ''`. In dev the
#   Vite proxy rewrites /api -> Railway, but that proxy does NOT run in a
#   production build served by `serve dist`. Without this value the bundled app
#   would call relative /api/... on its own origin and get the SPA fallback
#   (index.html) instead of JSON. Setting it here makes the build self-contained.
VITE_API_BASE=https://hospitable-courtesy-production-60a0.up.railway.app

# Supabase Auth — safe to commit (the anon key is meant to be public; it
# can only do what Supabase's policies and the backend's token check
# allow). Fill in from Supabase -> Project Settings -> API before deploying
# the sign-up/login screen. See README "Authentication" for the full setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
