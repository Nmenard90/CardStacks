# web/ commits its lockfile: without it every Railway build re-resolved
# dependencies from scratch and broke on an npm install crash (2026-10-15).
package-lock.json
!web/package-lock.json

# Local worktrees (one per task; see AGENTS.md) and Claude Code's own
.worktrees/
.claude/

# Applied patch files from the Claude workflow — never commit these
*.patch

# Scala/Metals/Bloop IDE build-server caches
.metals/
.bloop/
.bsp/
target/
poketracker-v2/project/metals.sbt

# Windows: "> nul" from a POSIX shell creates a real file named nul
nul

# Editor settings stay per-machine
.vscode/
.idea/
