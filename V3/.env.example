# File: .env.example
# Purpose: Lists all environment variables used by TCG V3.
# Important: Copy this file to .env locally. Never commit real secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tcg_v3

PUBLIC_WEB_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
POKEMON_TCG_API_KEY=
POKEMON_TCG_PAGE_SIZE=250

OPEN_TCG_API_BASE_URL=https://openapi.tcgtracking.com
OPEN_TCG_POKEMON_CATEGORY_ID=
OPEN_TCG_PRICE_SOURCE_NAME=open_tcg

RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_GENERAL_WINDOW=1 minute
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=1 minute
RATE_LIMIT_SEARCH_MAX=60
RATE_LIMIT_SEARCH_WINDOW=1 minute
RATE_LIMIT_IMPORT_MAX=5
RATE_LIMIT_IMPORT_WINDOW=1 hour

ADMIN_EMAILS=

BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
