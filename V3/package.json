{
  "name": "tcg-v3",
  "version": "0.1.0",
  "private": true,
  "description": "Production-minded V3 restart of the Pokémon card collection app.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "^22.0.0",
    "pnpm": "^9.15.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo dev --filter=@tcg/api --filter=@tcg/web --env-mode=loose",
    "dev:all": "dotenv -e .env -- turbo dev --env-mode=loose",
    "dev:worker": "dotenv -e .env -- pnpm --filter @tcg/worker dev",
    "build": "dotenv -e .env -- turbo build",
    "lint": "pnpm run prisma:generate && pnpm run lint:turbo",
    "typecheck": "pnpm run prisma:generate && pnpm run typecheck:turbo",
    "test": "pnpm run prisma:generate && pnpm run test:turbo",
    "db:generate": "dotenv -e .env -- pnpm --filter @tcg/db db:generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @tcg/db db:migrate",
    "db:seed": "dotenv -e .env -- pnpm --filter @tcg/db db:seed",
    "prepush": "pnpm run prisma:generate && pnpm run lint:turbo && pnpm run typecheck:turbo && pnpm run test:turbo",
    "prisma:generate": "pnpm --filter @tcg/db generate",
    "lint:turbo": "turbo lint",
    "typecheck:turbo": "dotenv -e .env -- turbo typecheck",
    "test:turbo": "dotenv -e .env -- turbo test"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
