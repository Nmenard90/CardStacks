# File: .dockerignore
# Purpose:
#   Keeps the Docker build context limited to source needed for the image.
#
# Why this file exists:
#   Without this file, `COPY . .` in service Dockerfiles pulls in host
#   node_modules, .env secrets, and local build/test output. That breaks the
#   frozen-lockfile install (host binaries can shadow the container's Linux
#   build) and risks baking secrets into image layers.

# Secrets
.env
.env.local
.env.production
.env.*.local

# Dependencies (reinstalled inside the image from the lockfile)
node_modules
.pnpm-store

# Build output (rebuilt inside the image)
dist
build
coverage

# Git and editor metadata
.git
.gitignore
.idea
.vscode
.DS_Store

# Turborepo local cache
.turbo

# Docs not needed inside the image
docs
memory-bank
*.md
