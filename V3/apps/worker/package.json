{
  "name": "@tcg/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "pnpm --filter @tcg/shared build && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:sync-catalog": "node dist/index.js sync-catalog",
    "start:sync-prices": "node dist/index.js sync-prices",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "sync:catalog": "tsx src/index.ts sync-catalog",
    "sync:prices": "tsx src/index.ts sync-prices"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@tcg/shared": "workspace:*",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
